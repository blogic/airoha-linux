/dts-v1/;

#include "an7589.dtsi"

/ {
	model = "Airoha AN7589 Evaluation Board";
	compatible = "airoha,an7589-evb", "airoha,an7589";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};
};
