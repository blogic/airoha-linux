/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7589.dtsi"

/ {
	model = "Airoha AN7589 Evaluation Board";
	compatible = "airoha,an7589-evb", "airoha,an7589";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7589_pinctrl 0 GPIO_ACTIVE_LOW>;
		};

		button-1 {
			label = "button1";
			linux,code = <BTN_0>;
			gpios = <&an7589_pinctrl 1 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&an7589_pinctrl 3 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};

	pwm-leds {
		compatible = "pwm-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pwm_gpio4_pins>;

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			pwms = <&an7589_pwm 4 4000000 0>;
			max-brightness = <255>;
			active-low;
		};
	};
};

&an7589_pinctrl {
	gpio-ranges = <&an7589_pinctrl 0 0 74>;

	pwm_gpio4_pins: pwm-gpio4-pins {
		mux {
			function = "pwm";
			groups = "gpio4";
		};

		conf {
			pins = "gpio4";
			output-enable;
		};
	};
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pins>;
	status = "okay";
};

&mdio0 {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio0_pins>;
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	ethernet-phy@19 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x19>;
		reset-gpios = <&an7589_pinctrl 26 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <350000>;
	};

	ethernet-phy@1b {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1b>;
		reset-gpios = <&an7589_pinctrl 28 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <350000>;
	};

	ethernet-phy@1d {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <0x1d>;
		reset-gpios = <&an7589_pinctrl 43 GPIO_ACTIVE_LOW>;
		reset-assert-us = <200000>;
		reset-deassert-us = <350000>;
	};
};

&snfi {
	status = "okay";
};

&spi_nand {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		bl2@0 {
			label = "bl2";
			reg = <0x00000000 0x00200000>;
			read-only;
		};

		ubi@200000 {
			compatible = "linux,ubi";
			label = "ubi";
			reg = <0x00200000 0x00000000>;

			volumes {
				ubi-volume-fip {
					volname = "fip";
				};

				ubi-volume-ubootenv {
					volname = "ubootenv";
				};

				ubi-volume-ubootenv2 {
					volname = "ubootenv2";
				};

				ubi-volume-art {
					volname = "art";
				};

				ubi-volume-kernel {
					volname = "kernel";
				};

				ubi-volume-rootfs {
					volname = "rootfs";
				};

				ubi-volume-kernel-alt {
					volname = "kernel_alt";
				};

				ubi-volume-rootfs-alt {
					volname = "rootfs_alt";
				};

				ubi-volume-rootfs-data {
					volname = "rootfs_data";
				};
			};
		};
	};
};
