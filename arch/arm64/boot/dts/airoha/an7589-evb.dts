/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "an7589.dtsi"

/ {
	model = "Airoha AN7589 Evaluation Board";
	compatible = "airoha,an7589-evb", "airoha,an7589";

	aliases {
		serial0 = &uart1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x0 0x80000000 0x0 0x80000000>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		button-0 {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&an7589_pinctrl 0 GPIO_ACTIVE_LOW>;
		};

		button-1 {
			label = "button1";
			linux,code = <BTN_0>;
			gpios = <&an7589_pinctrl 1 GPIO_ACTIVE_LOW>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led-0 {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			gpios = <&an7589_pinctrl 3 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};
};

&an7589_pinctrl {
	gpio-ranges = <&an7589_pinctrl 0 0 74>;
};
